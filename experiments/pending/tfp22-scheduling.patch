+"""Prompt bounds and live-client transitions, against independent causal output."""
+from dataclasses import FrozenInstanceError
+from concurrent.futures import ThreadPoolExecutor
+from itertools import product
+import threading
+import unittest
+
+from tensorfold.families.glm_moe_dsa.schedule_plan import PrefillPlan,prompt_quotas
+from tensorfold.families.glm_moe_dsa.request import RequestEngine
+from tensorfold.families.glm_moe_dsa.control import Replica
+from test_glm53_full_tp6_request import CausalBackend,serial
+from test_glm53_full_tp6_packed import enable_batch
+from test_glm53_full_tp6_scheduler import ScheduledFleet
+from test_glm53_full_tp6_control import Fleet
+
+
+class Quotas(unittest.TestCase):
+    def test_all_small_demands_conserve_budget_and_never_overfill(self):
+        for needs in product((0,1,3,11),repeat=4):
+            for budget in (1,3,7,11):
+                for cursor in (0,1,7):
+                    got=prompt_quotas(list(needs),budget,cursor)
+                    self.assertEqual(sum(got),min(sum(needs),budget))
+                    self.assertTrue(all(0<=x<=n for x,n in zip(got,needs)))
+        served=[prompt_quotas([20]*4,1,i).index(1) for i in range(4)]
+        self.assertEqual(set(served),{0,1,2,3})
+        self.assertEqual(sorted(prompt_quotas([1,100,100,0],10,0)),[0,1,4,5])
+
+    def test_plan_bounds_and_immutability(self):
+        p=PrefillPlan(3072,256)
+        with self.assertRaises(FrozenInstanceError):p.mixed_rows=3072
+        for args in [(0,1),(3073,256),(256,257),(True,1),(256,False)]:
+            with self.assertRaises(ValueError):PrefillPlan(*args)
+        for args in [([1],0,0),([True],1,0),([1],1,-1),([1]*5,1,0)]:
+            with self.assertRaises(ValueError):prompt_quotas(*args)
+        with self.assertRaises(ValueError):RequestEngine(CausalBackend(),context_limit=128,prefill_plan=PrefillPlan(12,4))
+
+    def test_mixed_prefill_is_bounded_while_decode_makes_progress(self):
+        e=RequestEngine(enable_batch(CausalBackend()),context_limit=128,prefill_plan=PrefillPlan(10,4))
+        active=e.start('decode',[2,3],max_tokens=60,ignore_eos=True)
+        e.step(active)
+        prompts=[[7,3,1]*25,[5,9]*39]
+        queued=[e.start(str(i),p,max_tokens=8,ignore_eos=True) for i,p in enumerate(prompts)]
+        for round_index in range(200):
+            requests=[r for r in (active,*queued) if r.status in ('prefill','decode')]
+            if not requests:break
+            prefills=[r for r in requests if r.status=='prefill']
+            before={r.key:len(r.tokens) for r in prefills};had_decode=any(r.status=='decode' for r in requests)
+            outputs=len(active.output)
+            e.step_many(requests,[False]*len(requests))
+            added=sum(len(r.tokens)-before[r.key] for r in prefills)
+            self.assertLessEqual(added,4 if had_decode and prefills else 10)
+            if active in requests:self.assertGreater(len(active.output),outputs)
+        self.assertEqual(active.output,serial([2,3],60,None))
+        for p,r in zip(prompts,queued):self.assertEqual(r.output,serial(p,8,None))
+        self.assertGreater(e.schedule_counts['mixed_rounds'],0)
+        self.assertLessEqual(e.schedule_counts['max_mixed_prefill_rows'],4)
+
+    def test_tiny_budget_rotates_without_losing_prefixes_or_cancellation(self):
+        e=RequestEngine(enable_batch(CausalBackend()),context_limit=128,prefill_plan=PrefillPlan(1,1))
+        rs=[e.start(str(i),[i+1,2,5],max_tokens=5,ignore_eos=True) for i in range(4)]
+        for _ in range(4):e.step_many(rs,[False]*4)
+        self.assertEqual([len(r.tokens) for r in rs],[1]*4)
+        for _ in range(80):
+            active=[r for r in rs if r.status in ('prefill','decode')]
+            if not active:break
+            e.step_many(active,[r is rs[3] for r in active])
+        self.assertEqual(rs[3].status,'cancelled');self.assertFalse(rs[3].output)
+        for i,r in enumerate(rs[:3]):self.assertEqual(r.output,serial([i+1,2,5],5,None))
+        self.assertEqual(e.schedule_counts['max_prefill_rows'],1)
+
+    def test_budget_and_cursor_participate_in_rank_fingerprint(self):
+        def configure(rank,core):
+            enable_batch(core.backend);core.prefill_plan=PrefillPlan(10,4)
+        f=Fleet(configure=configure);self.addCleanup(f.close)
+        from tensorfold.families.glm_moe_dsa.control import start_command
+        for i in range(3):f.dispatch(start_command(str(i),[i+1,2,5]*5,max_tokens=8))
+        f.dispatch(dict(op='step_many',args=dict(keys=['0','1','2'],cancelled=[False]*3)))
+        fingerprints={c.replica.fingerprint() for c in f.controllers.values()}
+        self.assertEqual(len(fingerprints),1)
+        for c in f.controllers.values():
+            self.assertEqual(sum(len(r.tokens) for r in c.replica.core.requests.values()),10)
+            self.assertEqual(c.replica.core.prefill_cursor,1)
+        c=f.controllers[2].replica.core
+        before=f.controllers[2].replica.fingerprint();c.prefill_plan=PrefillPlan(10,3)
+        self.assertNotEqual(f.controllers[2].replica.fingerprint(),before)
+        c.prefill_plan=PrefillPlan(10,4)
+        # The temporary host-only mutation never executes a request command.
+
+
+class LivePolicy(unittest.TestCase):
+    def test_join_leave_and_lone_client_never_use_packing(self):
+        entered,release=threading.Event(),threading.Event()
+        def configure(rank,b):
+            enable_batch(b)
+            original=b.target
+            first=True
+            def target(*args):
+                nonlocal first
+                if rank==0 and first:
+                    first=False;entered.set()
+                    if not release.wait(4):raise TimeoutError('test release missing')
+                return original(*args)
+            b.target=target
+        f=ScheduledFleet(configure=configure,packed=True)
+        try:
+            def run(prompt,count):
+                out=[];f.engine.generate(prompt,count,None,lambda t:out.extend(t));return out
+            with ThreadPoolExecutor(max_workers=3) as pool:
+                lone=pool.submit(run,[2,3],60)
+                self.assertTrue(entered.wait(3))
+                first=pool.submit(run,[4,7],8);second=pool.submit(run,[8,9,2],12)
+                with f.scheduler.condition:
+                    self.assertTrue(f.scheduler.condition.wait_for(lambda:len(f.scheduler.waiting)==2,timeout=3))
+                self.assertTrue(all(not b.groups for b in f.backends.values()))
+                release.set()
+                self.assertEqual(first.result(4),serial([4,7],8,None))
+                self.assertEqual(second.result(4),serial([8,9,2],12,None))
+                self.assertEqual(lone.result(4),serial([2,3],60,None))
+            counts=[len(b.groups) for b in f.backends.values()]
+            self.assertTrue(all(n>0 for n in counts))
+            self.assertEqual(run([7,1,3],9),serial([7,1,3],9,None))
+            self.assertEqual([len(b.groups) for b in f.backends.values()],counts)
+            for c in f.controllers.values():
+                self.assertGreater(c.replica.core.schedule_counts['scalar_rounds'],0)
+                self.assertGreater(c.replica.core.schedule_counts['packed_rounds'],0)
+        finally:
+            release.set();f.close()
+        self.assertFalse(f.errors)
+
+if __name__=='__main__':unittest.main()
