@@ -0,0 +1,40 @@
+"""Host-only, deterministic prompt quotas for one distributed request round."""
+from dataclasses import dataclass
+
+
+@dataclass(frozen=True)
+class PrefillPlan:
+    rows: int
+    mixed_rows: int
+
+    def __post_init__(self):
+        if (type(self.rows) is not int or type(self.mixed_rows) is not int
+                or not 1 <= self.mixed_rows <= self.rows <= 3072):
+            raise ValueError('Invalid prompt row budgets')
+
+
+def prompt_quotas(needs, budget, cursor):
+    """Water-fill a shared token budget; rotate indivisible remainder priority.
+
+    Zero needs represent decoders, cancellations or already-complete prompts.
+    Unused shares from short prompts are reassigned within this same budget.
+    The caller advances its cursor only after successfully executing the round.
+    """
+    if (not isinstance(needs, list) or not 1 <= len(needs) <= 4
+            or any(type(n) is not int or n < 0 for n in needs)
+            or type(budget) is not int or not 1 <= budget <= 3072
+            or type(cursor) is not int or cursor < 0):
+        raise ValueError('Invalid prompt quota inputs')
+    quotas = [0]*len(needs)
+    active = [i for i,n in enumerate(needs) if n]
+    if not active: return quotas
+    offset = cursor%len(active)
+    active = active[offset:]+active[:offset]
+    remaining = min(budget, sum(needs))
+    while remaining:
+        share = max(1,remaining//len(active))
+        for i in active:
+            take = min(share,needs[i]-quotas[i],remaining)
+            quotas[i] += take; remaining -= take
+        active = [i for i in active if quotas[i] < needs[i]]
+    return quotas
